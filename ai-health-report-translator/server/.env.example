NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ai_health_reporter
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h
CLIENT_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=10

# Optional. Without a key the app runs in "offline" mode with rule-based explanations.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# If the pattern parser finds fewer tests than this, redacted report text is sent to the AI to structure it. 0 disables.
AI_EXTRACTION_MIN_RESULTS=3
OCR_MAX_PAGES=5
